[67.564177, "o", "\u001b[2m# drill: freeze the VRRP master (r1) while h1 pings h2 at 5 packets per second\u001b[0m\r\n\r\n\u001b[32m$\u001b[0m \u001b[1mdocker exec clab-bastion-campus-r1 vtysh -c 'show vrrp' | grep 'Status (v4)'\u001b[0m\r\n"]
[67.755087, "o", " Status (v4)                             Master              \r\n"]
[67.760552, "o", "\r\n\u001b[32m$\u001b[0m \u001b[1mdocker exec clab-bastion-campus-h1 ping -i 0.2 -w 18 10.40.0.100   (running in background)\u001b[0m\r\n"]
[70.762645, "o", "\r\n\u001b[32m$\u001b[0m \u001b[1mdocker pause clab-bastion-campus-r1\u001b[0m\r\n"]
[70.902406, "o", "clab-bastion-campus-r1\r\n"]
[77.906444, "o", "\u001b[2m# the backup noticed the silence and took over the virtual IP:\u001b[0m\r\n\r\n\u001b[32m$\u001b[0m \u001b[1mdocker exec clab-bastion-campus-r2 vtysh -c 'show vrrp' | grep 'Status (v4)'\u001b[0m\r\n"]
[78.106953, "o", " Status (v4)                             Master              \r\n"]
[78.111587, "o", "\r\n\u001b[32m$\u001b[0m \u001b[1mdocker unpause clab-bastion-campus-r1\u001b[0m\r\n"]
[78.250675, "o", "clab-bastion-campus-r1\r\n"]
[85.940731, "o", "\r\n\u001b[32m$\u001b[0m \u001b[1mtail -3 /tmp/demo_ping.txt\u001b[0m\r\n"]
