[73.240291, "o", "\u001b[2m# drill: freeze the VRRP master (r1) while h1 pings h2 at 5 packets per second\u001b[0m\r\n\r\n\u001b[32m$\u001b[0m \u001b[1mdocker exec clab-bastion-campus-r1 vtysh -c 'show vrrp' | grep 'Status (v4)'\u001b[0m\r\n"]
[73.440174, "o", " Status (v4)                             Master              \r\n"]
[73.445172, "o", "\r\n\u001b[32m$\u001b[0m \u001b[1mdocker exec clab-bastion-campus-h1 ping -i 0.2 -w 18 10.40.0.100   (running in background)\u001b[0m\r\n"]
[76.447717, "o", "\r\n\u001b[32m$\u001b[0m \u001b[1mdocker pause clab-bastion-campus-r1\u001b[0m\r\n"]
[76.586369, "o", "clab-bastion-campus-r1\r\n"]
[83.589997, "o", "\u001b[2m# the backup noticed the silence and took over the virtual IP:\u001b[0m\r\n\r\n\u001b[32m$\u001b[0m \u001b[1mdocker exec clab-bastion-campus-r2 vtysh -c 'show vrrp' | grep 'Status (v4)'\u001b[0m\r\n"]
[83.816605, "o", " Status (v4)                             Master              \r\n"]
[83.820994, "o", "\r\n\u001b[32m$\u001b[0m \u001b[1mdocker unpause clab-bastion-campus-r1\u001b[0m\r\n"]
[83.972365, "o", "clab-bastion-campus-r1\r\n"]
[91.621425, "o", "\r\n\u001b[32m$\u001b[0m \u001b[1mtail -3 /tmp/demo_ping.txt\u001b[0m\r\n"]
