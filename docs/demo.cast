[91.623059, "o", "\u001b[2m# zero loss: VRRP failed over on schedule while the frozen kernel kept forwarding\u001b[0m\r\n\u001b[2m# measured takeover, pcaps, and the full story: modules/01-campus-core/artifacts/\u001b[0m\r\n"]
