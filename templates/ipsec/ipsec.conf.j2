# Generated by tools/generate.py. strongSwan legacy format.
# Transport mode IPsec protecting GRE (IP protocol 47) between the site
# loopbacks: the GRE tunnel carries the routing protocol, IPsec encrypts
# the GRE envelope. See the module README for why both layers exist.
config setup

conn %default
    keyexchange=ikev2
    ike=aes256-sha256-modp2048!
    esp=aes256-sha256-modp2048!
    keyingtries=%forever
    dpddelay=10s
    dpdaction=restart

conn gre
    type=transport
    authby=secret
    left={{ node.ipsec.local }}
    right={{ node.ipsec.peer }}
    leftprotoport=gre
    rightprotoport=gre
    auto=start
